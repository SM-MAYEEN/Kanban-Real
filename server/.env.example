PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/realtime-kanban
JWT_SECRET=replace-with-a-long-random-secret

# Gmail account and Google App Password; required for password reset and invites.
EMAIL_USER=
EMAIL_PASS=

# Required only when enabling S3 attachment uploads.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=

# Required only if Stripe payment routes are enabled.
STRIPE_SECRET_KEY=
